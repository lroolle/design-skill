{
  "name": "design-skill",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // lroolle.com is a Workers Custom Domain on the `lroolle` worker (the SPA).
  // This path route is additive and more specific, so it claims /design-skill*
  // and leaves every other path on that worker untouched. Deploying needs a
  // token with Zone > Workers Routes > Edit on lroolle.com.
  "routes": [
    { "pattern": "lroolle.com/design-skill*", "zone_name": "lroolle.com" }
  ],
  // keep the workers.dev URL alive beside the route: it is where the page can
  // be checked without touching lroolle.com
  "workers_dev": true,
  // version preview URLs, so a change this visible can be reviewed on its own
  // hostname before it reaches lroolle.com
  "preview_urls": true,
  "observability": { "enabled": true }
}
